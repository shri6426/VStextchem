# Enquiry form delivery. Leave empty until a provider is chosen (see README → "Enquiry form").
# Any endpoint that accepts a JSON POST works: Formspree, Web3Forms, Getform, or your own API.
VITE_ENQUIRY_ENDPOINT=
# Optional access key some providers require (e.g. Web3Forms "access_key").
VITE_ENQUIRY_ACCESS_KEY=
# Production URL, used for canonical links and the sitemap (no trailing slash).
VITE_SITE_URL=
