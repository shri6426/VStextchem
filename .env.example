# Enquiry form delivery endpoint (defaults to https://formsubmit.co/ajax/texchemvs@gmail.com).
# Any endpoint that accepts a JSON POST works: Formsubmit, Formspree, Web3Forms, Getform, or your own API.
VITE_ENQUIRY_ENDPOINT=https://formsubmit.co/ajax/texchemvs@gmail.com
# Optional access key some providers require (e.g. Web3Forms "access_key").
VITE_ENQUIRY_ACCESS_KEY=
# Production URL, used for canonical links and the sitemap (no trailing slash).
VITE_SITE_URL=
